<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_bg_white"
    android:orientation="vertical"
    tools:context=".TakeAttendanceActivity">

    <!-- Toolbar: back arrow, title, 3-dot options menu -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary_blue"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:contentInsetStartWithNavigation="0dp"
        app:menu="@menu/menu_take_attendance"
        app:navigationContentDescription="@string/back_description"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="@string/take_attendance"
        app:titleMarginStart="8dp"
        app:titleTextColor="@color/white" />

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background_light"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Summary card -->
            <LinearLayout
                android:id="@+id/cardSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Class name and date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvClassName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDate"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:backgroundTint="@color/input_fill"
                        android:fontFamily="sans-serif-medium"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_blue"
                        android:textSize="13sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_calendar"
                        app:iconPadding="8dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/primary_blue"
                        app:strokeColor="@color/divider_gray"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Present / Absent / Late chips (counts filled in code) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvChipPresent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/chip"
                        android:backgroundTint="@color/present_bg"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:textColor="@color/present_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvChipAbsent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/chip"
                        android:backgroundTint="@color/absent_bg"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:textColor="@color/absent_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvChipLate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/chip"
                        android:backgroundTint="@color/late_bg"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:textColor="@color/late_text"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Mark all present -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkAllPresent"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/mark_all_present"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_blue"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/primary_blue"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>

            <!-- Student list card; rows are built in code from the database -->
            <LinearLayout
                android:id="@+id/cardStudents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card"
                android:divider="@drawable/divider"
                android:dividerPadding="16dp"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:showDividers="middle">

                <LinearLayout
                    android:id="@+id/listStudents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- Shown when the class has no students yet -->
            <TextView
                android:id="@+id/tvEmptyStudents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/no_students_in_class"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_bar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAttendance"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:elevation="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="@string/save_attendance"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
