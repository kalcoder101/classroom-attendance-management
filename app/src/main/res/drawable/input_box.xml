<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- focused: thick blue border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="2dp" android:color="@color/primary_blue" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- normal: clear dark-gray border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/input_fill" />
            <stroke android:width="1.5dp" android:color="@color/border_gray" />
            <corners android:radius="10dp" />
        </shape>
    </item>

</selector>