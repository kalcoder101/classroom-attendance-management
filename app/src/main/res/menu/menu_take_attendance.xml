<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- "Sort by" label (disabled, so it only works as a heading) -->
    <item
        android:id="@+id/menu_sort_header"
        android:enabled="false"
        android:title="@string/menu_sort_by"
        app:showAsAction="never" />

    <!-- Radio choice: only one can be selected -->
    <group
        android:id="@+id/group_sort"
        android:checkableBehavior="single">
        <item
            android:id="@+id/menu_sort_name"
            android:checked="true"
            android:title="@string/menu_sort_name"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_sort_id"
            android:title="@string/menu_sort_id"
            app:showAsAction="never" />
    </group>

    <!-- Checkbox -->
    <item
        android:id="@+id/menu_show_id"
        android:checkable="true"
        android:checked="true"
        android:title="@string/menu_show_id"
        app:showAsAction="never" />

    <item
        android:id="@+id/menu_settings"
        android:title="@string/menu_settings"
        app:showAsAction="never" />

    <item
        android:id="@+id/menu_logout"
        android:title="@string/logout"
        app:showAsAction="never" />
</menu>